#!/bin/bash

# K Language CLI - Thin wrapper around run-tests.sh
# This ensures consistent behavior between direct CLI use and test runner

if [ -z "$1" ]; then
    echo "Usage: k <file.k> [options]"
    echo ""
    echo "Options are passed through to the solver/Frontend."
    echo "Common options:"
    echo "  -cvc5          Use CVC5 solver instead of Z3"
    echo "  -debug         Enable debug output"
    echo "  -timeout N     Set solver timeout in milliseconds"
    echo "  -unified       Use UnifiedSolver"
    echo "  -heapcegar     Use heap CEGAR mode"
    echo "  -minizinc      Use MiniZinc solver"
    echo ""
    echo "For full test runner options, use: ./run-tests.sh -h"
    exit 1
fi

# Resolve symlinks to get the actual directory
if command -v readlink >/dev/null 2>&1 && readlink -f / >/dev/null 2>&1; then
    SCRIPT_PATH=$(readlink -f "${BASH_SOURCE[0]}")
elif command -v greadlink >/dev/null 2>&1; then
    SCRIPT_PATH=$(greadlink -f "${BASH_SOURCE[0]}")
else
    SCRIPT_PATH="${BASH_SOURCE[0]}"
    while [ -L "$SCRIPT_PATH" ]; do
        LINK=$(readlink "$SCRIPT_PATH")
        if [[ "$LINK" == /* ]]; then
            SCRIPT_PATH="$LINK"
        else
            SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/$LINK"
        fi
    done
fi
DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
PROJECT_ROOT="$(cd "$DIR/.." && pwd)"

# Parse arguments - find the .k file and collect other args as flags
K_FILE=""
FLAGS=""
for arg in "$@"; do
    if [[ "$arg" == *.k ]]; then
        K_FILE="$arg"
    else
        FLAGS="$FLAGS $arg"
    fi
done

if [ -z "$K_FILE" ]; then
    echo "Please provide a .k file."
    exit 1
fi

# Delegate to run-tests.sh -test with passthrough flags
# This ensures consistent behavior with the test runner
if [ -n "$FLAGS" ]; then
    exec "$PROJECT_ROOT/run-tests.sh" -test "$K_FILE" -- $FLAGS
else
    exec "$PROJECT_ROOT/run-tests.sh" -test "$K_FILE"
fi
