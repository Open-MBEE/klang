#!/bin/bash

DATE=`date +%Y-%m-%d`

if [ -z "$1" ] 
then 
    echo "Please provide a target platform: windows | macos-intel | macos-arm64 | linux"
    exit -1
fi

listcontains() {
  for word in $1; do
    [[ $word = $2 ]] && return 0
  done
  return 1
}
oslist="windows macos-intel macos-arm64 linux"
if listcontains "$oslist" $1; 
then 
    echo "Creating drop for $1..."; 
else 
    echo "Unknown platform specified. Supported choices: windows | macos-intel | macos-arm64 | linux"
    exit -1
fi


if [ -z "$2" ] 
then 
    echo "Please provide a directory name where the drop is to be created."
    exit -1
fi

KDIR="$2/k-$1-$DATE"

if [ -d $KDIR ] 
then
    echo "Directory already exists..."
  exit -1
fi

mkdir $KDIR

# Copy base lib directory (excluding platform-specific subdirectories)
mkdir $KDIR/lib
for f in lib/*; do
    if [ -f "$f" ]; then
        cp "$f" $KDIR/lib/
    fi
done

# Copy platform-specific Z3 libraries
case "$1" in
    windows)
        cp k.cmd $KDIR/
        if [ -d lib/windows ]; then
            cp lib/windows/* $KDIR/lib/
        else
            echo "Warning: lib/windows not found, using old libraries"
        fi
        ;;
    macos-intel)
        cp k $KDIR/
        if [ -d lib/x86_64 ]; then
            cp lib/x86_64/* $KDIR/lib/
        else
            echo "Warning: lib/x86_64 not found"
        fi
        ;;
    macos-arm64)
        cp k $KDIR/
        if [ -d lib/arm64 ]; then
            cp lib/arm64/* $KDIR/lib/
        else
            echo "Warning: lib/arm64 not found"
        fi
        ;;
    linux)
        cp k $KDIR/
        if [ -d lib/linux ]; then
            cp lib/linux/* $KDIR/lib/
        else
            echo "Warning: lib/linux not found"
        fi
        ;;
esac

cp -r ../src/tests $KDIR/tests
cp -r ../src/examples $KDIR/examples
cp ../README.md $KDIR/
cp ../SETUP.md $KDIR/

echo "Done."
echo "Created distribution in: $KDIR"
echo "Platform: $1"
