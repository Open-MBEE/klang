<idea-plugin>
    <id>nasa.jpl.klang.ide</id>
    <name>K Language</name>
    <version>0.5.0</version>
    <vendor email="klang@jpl.nasa.gov" url="https://github.com/nasa-jpl/klang">NASA JPL</vendor>

    <description><![CDATA[
    Support for the K constraint programming language.

    <h2>Features</h2>
    <ul>
        <li>Syntax highlighting for K files (.k)</li>
        <li>Code completion (IntelliSense) for keywords, types, and symbols</li>
        <li>Real-time error highlighting and diagnostics</li>
        <li>Code formatting (Ctrl+Alt+L)</li>
        <li>Code folding for classes, functions, and comments</li>
        <li>Breadcrumb navigation</li>
        <li>Rename refactoring (Shift+F6)</li>
        <li>Run K files (right-click → Run, or Cmd+Shift+R)</li>
        <li>Solution visualization tool window</li>
        <li>Find Usages (Alt+F7)</li>
        <li>Go to Definition (Ctrl+Click / F12)</li>
        <li>Structure View (Alt+7) - navigate classes, functions, properties</li>
        <li>Documentation on hover (Ctrl+Q)</li>
        <li>Comment support (-- // /* */ and ===...===)</li>
        <li>Bracket matching</li>
        <li>Color scheme customization</li>
    </ul>

    <h2>About K</h2>
    <p>K is a declarative constraint programming language backed by the Z3 SMT solver,
    designed for modeling, verification, and specification at NASA JPL.</p>
    ]]></description>

    <change-notes><![CDATA[
    <h3>0.5.0</h3>
    <ul>
        <li>Code folding for classes, functions, and block comments</li>
        <li>Breadcrumb navigation (package → class → function)</li>
        <li>Improved block comment support (/* */ and ===...===)</li>
    </ul>
    <h3>0.4.0</h3>
    <ul>
        <li>Code completion for keywords, types, and symbols</li>
        <li>Real-time error highlighting and diagnostics</li>
        <li>Code formatting support</li>
        <li>Rename refactoring</li>
        <li>Solution visualization tool window</li>
    </ul>
    <h3>0.3.0</h3>
    <ul>
        <li>Run K files directly from the IDE</li>
        <li>Auto-detect K installation and SDKMAN Java</li>
        <li>Run configuration with customizable settings</li>
    </ul>
    <h3>0.1.0</h3>
    <ul>
        <li>Initial release</li>
        <li>Syntax highlighting</li>
        <li>Comment support</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type -->
        <fileType
            name="K File"
            implementationClass="nasa.jpl.klang.ide.KFileType"
            fieldName="INSTANCE"
            language="K"
            extensions="k"/>

        <!-- Parser -->
        <lang.parserDefinition
            language="K"
            implementationClass="nasa.jpl.klang.ide.parser.KParserDefinition"/>

        <!-- Syntax Highlighting -->
        <lang.syntaxHighlighterFactory
            language="K"
            implementationClass="nasa.jpl.klang.ide.highlighting.KSyntaxHighlighterFactory"/>

        <!-- Commenter -->
        <lang.commenter
            language="K"
            implementationClass="nasa.jpl.klang.ide.KCommenter"/>

        <!-- Brace Matching -->
        <lang.braceMatcher
            language="K"
            implementationClass="nasa.jpl.klang.ide.KBraceMatcher"/>

        <!-- Structure View -->
        <lang.psiStructureViewFactory
            language="K"
            implementationClass="nasa.jpl.klang.ide.structure.KStructureViewFactory"/>

        <!-- Find Usages -->
        <lang.findUsagesProvider
            language="K"
            implementationClass="nasa.jpl.klang.ide.navigation.KFindUsagesProvider"/>

        <!-- Go to Declaration -->
        <gotoDeclarationHandler
            implementationClass="nasa.jpl.klang.ide.navigation.KGotoDeclarationHandler"/>

        <!-- Documentation -->
        <lang.documentationProvider
            language="K"
            implementationClass="nasa.jpl.klang.ide.documentation.KDocumentationProvider"/>

        <!-- Color Settings Page (Preferences → Editor → Color Scheme → K) -->
        <colorSettingsPage
            implementationClass="nasa.jpl.klang.ide.highlighting.KColorSettingsPage"/>

        <!-- Reference Contributor (enables Find Usages) -->
        <psi.referenceContributor
            language="K"
            implementation="nasa.jpl.klang.ide.psi.KReferenceContributor"/>

        <!-- Run Configuration -->
        <configurationType
            implementation="nasa.jpl.klang.ide.run.KRunConfigurationType"/>

        <runConfigurationProducer
            implementation="nasa.jpl.klang.ide.run.KRunConfigurationProducer"/>

        <!-- Run Line Marker (gutter icon) -->
        <runLineMarkerContributor
            language="K"
            implementationClass="nasa.jpl.klang.ide.run.KRunLineMarkerContributor"/>

        <!-- Code Completion -->
        <completion.contributor
            language="K"
            implementationClass="nasa.jpl.klang.ide.completion.KCompletionContributor"/>

        <!-- Code Formatting -->
        <lang.formatter
            language="K"
            implementationClass="nasa.jpl.klang.ide.formatting.KFormattingModelBuilder"/>

        <!-- Code Folding -->
        <lang.foldingBuilder
            language="K"
            implementationClass="nasa.jpl.klang.ide.folding.KFoldingBuilder"/>

        <!-- Breadcrumbs -->
        <breadcrumbsInfoProvider
            implementation="nasa.jpl.klang.ide.breadcrumbs.KBreadcrumbsProvider"/>

        <!-- Live Templates -->
        <liveTemplateContext
            implementation="nasa.jpl.klang.ide.templates.KTemplateContext"/>
        <defaultLiveTemplates file="/liveTemplates/K.xml"/>

        <!-- Annotator (error highlighting) -->
        <annotator
            language="K"
            implementationClass="nasa.jpl.klang.ide.highlighting.KAnnotator"/>

        <!-- Refactoring Support -->
        <lang.refactoringSupport
            language="K"
            implementationClass="nasa.jpl.klang.ide.refactoring.KRefactoringSupportProvider"/>

        <!-- Solution Tool Window -->
        <toolWindow
            id="K Solution"
            anchor="bottom"
            secondary="true"
            factoryClass="nasa.jpl.klang.ide.toolwindow.KSolutionToolWindowFactory"
            icon="/icons/k_icon.svg"/>
    </extensions>
</idea-plugin>
