<idea-plugin>
    <id>nasa.jpl.klang.ide</id>
    <name>K Language</name>
    <version>0.1.0</version>
    <vendor email="klang@jpl.nasa.gov" url="https://github.com/nasa-jpl/klang">NASA JPL</vendor>

    <description><![CDATA[
    Support for the K constraint programming language.

    <h2>Features</h2>
    <ul>
        <li>Syntax highlighting for K files (.k)</li>
        <li>Comment support (line and block)</li>
        <li>Bracket matching</li>
    </ul>

    <h2>About K</h2>
    <p>K is a declarative constraint programming language backed by the Z3 SMT solver,
    designed for modeling, verification, and specification at NASA JPL.</p>
    ]]></description>

    <change-notes><![CDATA[
    <h3>0.1.0</h3>
    <ul>
        <li>Initial release</li>
        <li>Syntax highlighting</li>
        <li>Comment support</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type -->
        <fileType
            name="K File"
            implementationClass="nasa.jpl.klang.ide.KFileType"
            fieldName="INSTANCE"
            language="K"
            extensions="k"/>

        <!-- Syntax Highlighting -->
        <lang.syntaxHighlighterFactory
            language="K"
            implementationClass="nasa.jpl.klang.ide.highlighting.KSyntaxHighlighterFactory"/>

        <!-- Commenter -->
        <lang.commenter
            language="K"
            implementationClass="nasa.jpl.klang.ide.KCommenter"/>

        <!-- Brace Matching -->
        <lang.braceMatcher
            language="K"
            implementationClass="nasa.jpl.klang.ide.KBraceMatcher"/>
    </extensions>
</idea-plugin>

