        <context>
            <option name="K" value="true"/>
        </context>
    </template>
    <!-- Bitvector Property Declarations -->
    <template name="int8" value="$NAME$ : Int8 = $VALUE$" description="Int8 property" toReformat="true" toShortenFQNames="true">
        <variable name="NAME" expression="" defaultValue="byteVal" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="0" alwaysStopAt="true"/>
        <context>
