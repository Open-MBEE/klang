{
  "Class definition": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName} {",
      "  $0",
      "}"
    ],
    "description": "Class definition"
  },
  "Class extends": {
    "prefix": "classext",
    "body": [
      "class ${1:ClassName} extends ${2:ParentClass} {",
      "  $0",
      "}"
    ],
    "description": "Class extending another class"
  },
  "Function definition": {
    "prefix": "fun",
    "body": [
      "fun ${1:functionName}(${2:params}) : ${3:ReturnType} {",
      "  $0",
      "}"
    ],
    "description": "Function definition"
  },
  "Function (no body)": {
    "prefix": "funv",
    "body": [
      "fun ${1:functionName}(${2:params}) : ${3:ReturnType}"
    ],
    "description": "Function declaration without body"
  },
  "Property": {
    "prefix": "prop",
    "body": [
      "${1:name} : ${2:Type}"
    ],
    "description": "Property declaration"
  },
  "Property with value": {
    "prefix": "propv",
    "body": [
      "${1:name} : ${2:Type} = ${3:value}"
    ],
    "description": "Property with initial value"
  },
  "Constraint": {
    "prefix": "req",
    "body": [
      "req ${1:constraint}"
    ],
    "description": "Constraint (req)"
  },
  "Named constraint": {
    "prefix": "reqn",
    "body": [
      "req ${1:Name}: ${2:constraint}"
    ],
    "description": "Named constraint"
  },
  "Soft constraint": {
    "prefix": "soft",
    "body": [
      "soft req ${1:constraint}"
    ],
    "description": "Soft constraint"
  },
  "Forall quantifier": {
    "prefix": "forall",
    "body": [
      "forall ${1:x} : ${2:Type} :- ${3:condition} => ${4:body}"
    ],
    "description": "Universal quantifier"
  },
  "Exists quantifier": {
    "prefix": "exists",
    "body": [
      "exists ${1:x} : ${2:Type} :- ${3:condition} => ${4:body}"
    ],
    "description": "Existential quantifier"
  },
  "Package declaration": {
    "prefix": "package",
    "body": [
      "package ${1:packageName}",
      "",
      "$0"
    ],
    "description": "Package declaration"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import ${1:packageName}"
    ],
    "description": "Import statement"
  },
  "Association": {
    "prefix": "assoc",
    "body": [
      "assoc ${1:AssocName} {",
      "  source ${2:SourceClass}",
      "  target ${3:TargetClass}",
      "  $0",
      "}"
    ],
    "description": "Association definition"
  },
  "If-then-else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then ${2:thenExpr} else ${3:elseExpr}"
    ],
    "description": "If-then-else expression"
  },
  "Block comment": {
    "prefix": "/**",
    "body": [
      "/**",
      " * ${1:description}",
      " */"
    ],
    "description": "Block comment"
  },
  "Documentation block": {
    "prefix": "===",
    "body": [
      "==============================================",
      "${1:Documentation}",
      "=============================================="
    ],
    "description": "Documentation block with equals signs"
  },
  "Type cast to Int": {
    "prefix": "asint",
    "body": [
      "${1:expr} as Int"
    ],
    "description": "Cast expression to Int"
  },
  "Type cast to Real": {
    "prefix": "asreal",
    "body": [
      "${1:expr} as Real"
    ],
    "description": "Cast expression to Real"
  },
  "Type cast to Int8": {
    "prefix": "asint8",
    "body": [
      "${1:expr} as Int8"
    ],
    "description": "Cast expression to signed 8-bit integer"
  },
  "Type cast to Int16": {
    "prefix": "asint16",
    "body": [
      "${1:expr} as Int16"
    ],
    "description": "Cast expression to signed 16-bit integer"
  },
  "Type cast to Int32": {
    "prefix": "asint32",
    "body": [
      "${1:expr} as Int32"
    ],
    "description": "Cast expression to signed 32-bit integer"
  },
  "Type cast to Int64": {
    "prefix": "asint64",
    "body": [
      "${1:expr} as Int64"
    ],
    "description": "Cast expression to signed 64-bit integer"
  },
  "Type cast to UInt8": {
    "prefix": "asuint8",
    "body": [
      "${1:expr} as UInt8"
    ],
    "description": "Cast expression to unsigned 8-bit integer"
  },
  "Type cast to UInt16": {
    "prefix": "asuint16",
    "body": [
      "${1:expr} as UInt16"
    ],
    "description": "Cast expression to unsigned 16-bit integer"
  },
  "Type cast to UInt32": {
    "prefix": "asuint32",
    "body": [
      "${1:expr} as UInt32"
    ],
    "description": "Cast expression to unsigned 32-bit integer"
  },
  "Type cast to UInt64": {
    "prefix": "asuint64",
    "body": [
      "${1:expr} as UInt64"
    ],
    "description": "Cast expression to unsigned 64-bit integer"
  },
  "Signed 8-bit property": {
    "prefix": "int8",
    "body": [
      "${1:name} : Int8 = ${2:0}"
    ],
    "description": "Signed 8-bit integer property"
  },
  "Signed 16-bit property": {
    "prefix": "int16",
    "body": [
      "${1:name} : Int16 = ${2:0}"
    ],
    "description": "Signed 16-bit integer property"
  },
  "Signed 32-bit property": {
    "prefix": "int32",
    "body": [
      "${1:name} : Int32 = ${2:0}"
    ],
    "description": "Signed 32-bit integer property"
  },
  "Signed 64-bit property": {
    "prefix": "int64",
    "body": [
      "${1:name} : Int64 = ${2:0}"
    ],
    "description": "Signed 64-bit integer property"
  },
  "Unsigned 8-bit property": {
    "prefix": "uint8",
    "body": [
      "${1:name} : UInt8 = ${2:0}"
    ],
    "description": "Unsigned 8-bit integer property"
  },
  "Unsigned 16-bit property": {
    "prefix": "uint16",
    "body": [
      "${1:name} : UInt16 = ${2:0}"
    ],
    "description": "Unsigned 16-bit integer property"
  },
  "Unsigned 32-bit property": {
    "prefix": "uint32",
    "body": [
      "${1:name} : UInt32 = ${2:0}"
    ],
    "description": "Unsigned 32-bit integer property"
  },
  "Unsigned 64-bit property": {
    "prefix": "uint64",
    "body": [
      "${1:name} : UInt64 = ${2:0}"
    ],
    "description": "Unsigned 64-bit integer property"
  }
}

