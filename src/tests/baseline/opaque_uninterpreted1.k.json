  "model": "\nclass Problem {\n  x:Int\n  y:Int\n\n  fun mystery(n:Int) : Int\n\n\n  req x >= 0\n\n  req x <= 10\n\n  req mystery(0) = 0\n\n  req mystery(1) = 1\n\n  req mystery(2) = 4\n\n  req mystery(3) = 9\n  y:Int = mystery(x)\n\n  req y = 16\n}\n\np:Problem\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-datatypes () ((TopLevelDeclarations (mk-TopLevelDeclarations (p Ref)))))\n(declare-datatypes () ((Problem (mk-Problem (x Int)(y Int)(y Int)))))\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-TopLevelDeclarations (sel-TopLevelDeclarations TopLevelDeclarations))\n  (lift-Problem (sel-Problem Problem))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-TopLevelDeclarations ((this Ref)) Bool\n  (is-lift-TopLevelDeclarations (deref this))\n)\n\n(define-fun deref-TopLevelDeclarations ((this Ref)) TopLevelDeclarations\n  (sel-TopLevelDeclarations (deref this))\n)\n\n(define-fun deref-is-Problem ((this Ref)) Bool\n  (is-lift-Problem (deref this))\n)\n\n(define-fun deref-Problem ((this Ref)) Problem\n  (sel-Problem (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-TopLevelDeclarations ((this Ref)) Bool\n  (deref-is-TopLevelDeclarations this)\n)\n\n(define-fun deref-isa-Problem ((this Ref)) Bool\n  (deref-is-Problem this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; -------------------------------------------\n;   Getters for class TopLevelDeclarations:\n; -------------------------------------------\n\n; --- getters for TopLevelDeclarations.p: ---\n\n(define-fun TopLevelDeclarations!p ((this Ref)) Ref\n  (p (deref-TopLevelDeclarations this))\n)\n\n; ------------------------------\n;   Getters for class Problem:\n; ------------------------------\n\n; --- getters for Problem.x: ---\n\n(define-fun Problem!x ((this Ref)) Int\n  (x (deref-Problem this))\n)\n\n; --- getters for Problem.y: ---\n\n(define-fun Problem!y ((this Ref)) Int\n  (y (deref-Problem this))\n)\n\n; --- getters for Problem.y: ---\n\n(define-fun Problem!y ((this Ref)) Int\n  (y (deref-Problem this))\n)\n\n; ================\n; === Methods: ===\n; ================\n\n; ------------------------------\n;   Methods for class Problem:\n; ------------------------------\n\n(declare-fun Problem.mystery (Ref Int) Int)\n\n(define-fun Problem!mystery ((this Ref)(n Int)) Int\n  (Problem.mystery this n)\n)\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; ---------------------------------------------\n;   Invariant for class TopLevelDeclarations:\n; ---------------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-0-TopLevelDeclarations TopLevelDeclarations)\n\n; --- Invariant 1: ---\n\n(define-fun TopLevelDeclarations.inv1 ((this Ref)) Bool\n  (deref-isa-Problem (TopLevelDeclarations!p this))\n)\n\n(assert (! (TopLevelDeclarations.inv1 0) :named _xkassert0))\n\n\n\n; --------------------------------\n;   Invariant for class Problem:\n; --------------------------------\n\n; --- Constants: ---\n\n(declare-const const-1-Problem Problem)\n\n; --- Invariant 1: ---\n\n(define-fun Problem.inv1 ((this Ref)) Bool\n  (= (Problem!y this) (Problem!mystery this (Problem!x this)))\n)\n\n(assert (! (Problem.inv1 1) :named _xkassert1))\n\n; --- Invariant 2: ---\n\n(define-fun Problem.inv2 ((this Ref)) Bool\n  (>= (Problem!x this) 0)\n)\n\n(assert (! (Problem.inv2 1) :named _xkassert2))\n\n; --- Invariant 3: ---\n\n(define-fun Problem.inv3 ((this Ref)) Bool\n  (<= (Problem!x this) 10)\n)\n\n(assert (! (Problem.inv3 1) :named _xkassert3))\n\n; --- Invariant 4: ---\n\n(define-fun Problem.inv4 ((this Ref)) Bool\n  (= (Problem!mystery this 0) 0)\n)\n\n(assert (! (Problem.inv4 1) :named _xkassert4))\n\n; --- Invariant 5: ---\n\n(define-fun Problem.inv5 ((this Ref)) Bool\n  (= (Problem!mystery this 1) 1)\n)\n\n(assert (! (Problem.inv5 1) :named _xkassert5))\n\n; --- Invariant 6: ---\n\n(define-fun Problem.inv6 ((this Ref)) Bool\n  (= (Problem!mystery this 2) 4)\n)\n\n(assert (! (Problem.inv6 1) :named _xkassert6))\n\n; --- Invariant 7: ---\n\n(define-fun Problem.inv7 ((this Ref)) Bool\n  (= (Problem!mystery this 3) 9)\n)\n\n(assert (! (Problem.inv7 1) :named _xkassert7))\n\n; --- Invariant 8: ---\n\n(define-fun Problem.inv8 ((this Ref)) Bool\n  (= (Problem!y this) 16)\n)\n\n(assert (! (Problem.inv8 1) :named _xkassert8))\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store(store\n      ((as const (Array Ref Any)) null)\n        0 (lift-TopLevelDeclarations const-0-TopLevelDeclarations))\n        1 (lift-Problem const-1-Problem))\n  )\n)\n\n",
