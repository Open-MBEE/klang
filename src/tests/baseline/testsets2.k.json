{
  "name": "testsets2.k",
  "outcome": "SAT",
  "typeChecks": true,
  "model": "\nclass Sets {\n  s1:Set[Int]\n\n  req s1 = Set{x + 1 | x : Int . 10 <= x && x <= 15}\n\n  req Set{x | x : Int . 11 <= x && x <= 14} subset Set{x + 1 | x : Int . 10 <= x && x <= 15}\n\n  req 11 isin Set{x + 1 | x : Int . 10 <= x && x <= 15}\n\n  req 11 isin s1\n}\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-datatypes () ((Sets (mk-Sets (s1 (Set Int))))))\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-Sets (sel-Sets Sets))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-Sets ((this Ref)) Bool\n  (is-lift-Sets (deref this))\n)\n\n(define-fun deref-Sets ((this Ref)) Sets\n  (sel-Sets (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-Sets ((this Ref)) Bool\n  (deref-is-Sets this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; ---------------------------\n;   Getters for class Sets:\n; ---------------------------\n\n; --- getters for Sets.s1: ---\n\n(define-fun Sets!s1 ((this Ref)) (Set Int)\n  (s1 (deref-Sets this))\n)\n\n; ================\n; === Methods: ===\n; ================\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; -----------------------------\n;   Invariant for class Sets:\n; -----------------------------\n\n; --- Constants: ---\n\n(declare-const const-1-Sets Sets)\n\n; --- Invariant 1: ---\n\n(define-fun Sets.inv1 ((this Ref)) Bool\n  (forall ((var_1 Int)) (= (select (Sets!s1 this) (+ var_1 1)) (and (<= 10 var_1) (<= var_1 15))))\n)\n\n(assert (! (Sets.inv1 1) :named _xkassert0))\n\n; --- Invariant 2: ---\n\n(define-fun Sets.inv2 ((this Ref)) Bool\n  (forall ((var_2 Int)) (=> (and (<= 11 (+ var_2 1)) (<= (+ var_2 1) 14)) (and (<= 10 var_2) (<= var_2 15))))\n)\n\n(assert (! (Sets.inv2 1) :named _xkassert1))\n\n; --- Invariant 3: ---\n\n(define-fun Sets.inv3 ((this Ref)) Bool\n  (exists ((x Int)) (and (= 11 (+ x 1)) (and (<= 10 x) (<= x 15))))\n)\n\n(assert (! (Sets.inv3 1) :named _xkassert2))\n\n; --- Invariant 4: ---\n\n(define-fun Sets.inv4 ((this Ref)) Bool\n  (select (Sets!s1 this) 11)\n)\n\n(assert (! (Sets.inv4 1) :named _xkassert3))\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store\n      ((as const (Array Ref Any)) null)\n        1 (lift-Sets const-1-Sets))\n  )\n)\n\n",
  "smtModel": "(define-fun const-1-Sets () Sets\n  (let ((a!1 (store (store (store ((as const (Array Int Bool)) false) 16 true)\n                         13\n                         true)\n                  14\n                  true)))\n  (mk-Sets (store (store (store a!1 11 true) 15 true) 12 true))))\n(define-fun _xkassert2 () Bool\n  (exists ((x Int)) (and (= 11 (+ x 1)) (<= 10 x) (<= x 15))))\n(define-fun _xkassert3 () Bool\n  (select (s1 (sel-Sets (select heap 1))) 11))\n(define-fun _xkassert1 () Bool\n  (forall ((var_2 Int))\n  (=> (and (<= 11 (+ var_2 1)) (<= (+ var_2 1) 14))\n      (and (<= 10 var_2) (<= var_2 15)))))\n(define-fun _xkassert0 () Bool\n  (forall ((var_1 Int))\n  (let ((a!1 (select (s1 (sel-Sets (select heap 1))) (+ var_1 1))))\n    (= a!1 (and (<= 10 var_1) (<= var_1 15))))))\n(define-fun NULL$Ref () Int\n  (- 1))\n(define-fun heap () (Array Int Any)\n  (let ((a!1 (store (store (store ((as const (Array Int Bool)) false) 16 true)\n                         13\n                         true)\n                  14\n                  true)))\n(let ((a!2 (mk-Sets (store (store (store a!1 11 true) 15 true) 12 true))))\n  (store ((as const (Array Int Any)) null) 1 (lift-Sets a!2)))))",
