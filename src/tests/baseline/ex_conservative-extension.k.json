{
  "name": "conservative-extension.k",
  "outcome": "SAT",
  "typeChecks": true,
  "model": "\nclass SC {\n  mass:Int\n\n  req p: 10 <= mass && mass <= 15\n}\n\nclass Clipper extending SC {\n  bound:Int\n\n  req q: bound = 12 && mass <= bound\n}\n\nclass ConservativeProof1 {\n  B:Int = 40\n  pandq_impl_p:Bool = forall mass,bound : Int . ((10 <= mass && mass <= 15) && (bound = B) && (mass <= bound)) => (10 <= mass && mass <= 15)\n  pandq_equal_p:Bool = forall mass,bound : Int . ((10 <= mass && mass <= 15) && (bound = B) && (mass <= bound)) = (10 <= mass && mass <= 15)\n}\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-datatypes () ((SC (mk-SC (mass Int)))))\n(declare-datatypes () ((Clipper (mk-Clipper (mass Int)(bound Int)))))\n(declare-datatypes () ((ConservativeProof1 (mk-ConservativeProof1 (B Int)(pandq_impl_p Bool)(pandq_equal_p Bool)))))\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-SC (sel-SC SC))\n  (lift-Clipper (sel-Clipper Clipper))\n  (lift-ConservativeProof1 (sel-ConservativeProof1 ConservativeProof1))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-SC ((this Ref)) Bool\n  (is-lift-SC (deref this))\n)\n\n(define-fun deref-SC ((this Ref)) SC\n  (sel-SC (deref this))\n)\n\n(define-fun deref-is-Clipper ((this Ref)) Bool\n  (is-lift-Clipper (deref this))\n)\n\n(define-fun deref-Clipper ((this Ref)) Clipper\n  (sel-Clipper (deref this))\n)\n\n(define-fun deref-is-ConservativeProof1 ((this Ref)) Bool\n  (is-lift-ConservativeProof1 (deref this))\n)\n\n(define-fun deref-ConservativeProof1 ((this Ref)) ConservativeProof1\n  (sel-ConservativeProof1 (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-SC ((this Ref)) Bool\n  (or\n    (deref-is-SC this)\n    (deref-is-Clipper this)\n  )\n)\n\n(define-fun deref-isa-Clipper ((this Ref)) Bool\n  (deref-is-Clipper this)\n)\n\n(define-fun deref-isa-ConservativeProof1 ((this Ref)) Bool\n  (deref-is-ConservativeProof1 this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; -------------------------\n;   Getters for class SC:\n; -------------------------\n\n; --- getters for SC.mass: ---\n\n(define-fun SC!mass ((this Ref)) Int\n  (mass (deref-SC this))\n)\n\n; ------------------------------\n;   Getters for class Clipper:\n; ------------------------------\n\n; --- getters for Clipper.mass: ---\n\n(define-fun Clipper!mass ((this Ref)) Int\n  (mass (deref-Clipper this))\n)\n\n; --- getters for Clipper.bound: ---\n\n(define-fun Clipper!bound ((this Ref)) Int\n  (bound (deref-Clipper this))\n)\n\n; -----------------------------------------\n;   Getters for class ConservativeProof1:\n; -----------------------------------------\n\n; --- getters for ConservativeProof1.B: ---\n\n(define-fun ConservativeProof1!B ((this Ref)) Int\n  (B (deref-ConservativeProof1 this))\n)\n\n; --- getters for ConservativeProof1.pandq_impl_p: ---\n\n(define-fun ConservativeProof1!pandq_impl_p ((this Ref)) Bool\n  (pandq_impl_p (deref-ConservativeProof1 this))\n)\n\n; --- getters for ConservativeProof1.pandq_equal_p: ---\n\n(define-fun ConservativeProof1!pandq_equal_p ((this Ref)) Bool\n  (pandq_equal_p (deref-ConservativeProof1 this))\n)\n\n; ================\n; === Methods: ===\n; ================\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; ---------------------------\n;   Invariant for class SC:\n; ---------------------------\n\n; --- Constants: ---\n\n(declare-const const-1-SC SC)\n\n; --- Invariant 1: ---\n\n(define-fun SC.inv1 ((this Ref)) Bool\n  (and (<= 10 (SC!mass this)) (<= (SC!mass this) 15))\n)\n\n(assert (! (SC.inv1 1) :named _xkassert0))\n\n\n\n; --------------------------------\n;   Invariant for class Clipper:\n; --------------------------------\n\n; --- Constants: ---\n\n(declare-const const-2-Clipper Clipper)\n\n; --- Invariant 1: ---\n\n(define-fun Clipper.inv1 ((this Ref)) Bool\n  (and (<= 10 (Clipper!mass this)) (<= (Clipper!mass this) 15))\n)\n\n(assert (! (Clipper.inv1 2) :named _xkassert1))\n\n; --- Invariant 2: ---\n\n(define-fun Clipper.inv2 ((this Ref)) Bool\n  (and (= (Clipper!bound this) 12) (<= (Clipper!mass this) (Clipper!bound this)))\n)\n\n(assert (! (Clipper.inv2 2) :named _xkassert2))\n\n\n\n; -------------------------------------------\n;   Invariant for class ConservativeProof1:\n; -------------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-3-ConservativeProof1 ConservativeProof1)\n\n; --- Invariant 1: ---\n\n(define-fun ConservativeProof1.inv1 ((this Ref)) Bool\n  (= (ConservativeProof1!B this) 40)\n)\n\n(assert (! (ConservativeProof1.inv1 3) :named _xkassert3))\n\n; --- Invariant 2: ---\n\n(define-fun ConservativeProof1.inv2 ((this Ref)) Bool\n  (= (ConservativeProof1!pandq_impl_p this) (forall ((mass Int)(bound Int)) (=> (and (and (and (<= 10 mass) (<= mass 15)) (= bound (ConservativeProof1!B this))) (<= mass bound)) (and (<= 10 mass) (<= mass 15)))))\n)\n\n(assert (! (ConservativeProof1.inv2 3) :named _xkassert4))\n\n; --- Invariant 3: ---\n\n(define-fun ConservativeProof1.inv3 ((this Ref)) Bool\n  (= (ConservativeProof1!pandq_equal_p this) (forall ((mass Int)(bound Int)) (= (and (and (and (<= 10 mass) (<= mass 15)) (= bound (ConservativeProof1!B this))) (<= mass bound)) (and (<= 10 mass) (<= mass 15)))))\n)\n\n(assert (! (ConservativeProof1.inv3 3) :named _xkassert5))\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store(store(store\n      ((as const (Array Ref Any)) null)\n        1 (lift-SC const-1-SC))\n        2 (lift-Clipper const-2-Clipper))\n        3 (lift-ConservativeProof1 const-3-ConservativeProof1))\n  )\n)\n\n",
  "smtModel": "(define-fun _xkassert2 () Bool\n  (let ((a!1 (= (bound (sel-Clipper (select heap 2))) 12))\n      (a!2 (<= (mass (sel-Clipper (select heap 2)))\n               (bound (sel-Clipper (select heap 2))))))\n  (and a!1 a!2)))\n(define-fun _xkassert3 () Bool\n  (= (B (sel-ConservativeProof1 (select heap 3))) 40))\n(define-fun _xkassert5 () Bool\n  (let ((a!1 (forall ((mass Int) (bound Int))\n             (let ((a!1 (= bound (B (sel-ConservativeProof1 (select heap 3))))))\n               (= (and (and (<= 10 mass) (<= mass 15)) a!1 (<= mass bound))\n                  (and (<= 10 mass) (<= mass 15)))))))\n  (= (pandq_equal_p (sel-ConservativeProof1 (select heap 3))) a!1)))\n(define-fun const-1-SC () SC\n  (mk-SC 10))\n(define-fun heap () (Array Int Any)\n  (let ((a!1 (store (store ((as const (Array Int Any)) null)\n                         1\n                         (lift-SC (mk-SC 10)))\n                  2\n                  (lift-Clipper (mk-Clipper 10 12)))))\n  (store a!1 3 (lift-ConservativeProof1 (mk-ConservativeProof1 40 true false)))))\n(define-fun _xkassert1 () Bool\n  (let ((a!1 (<= 10 (mass (sel-Clipper (select heap 2)))))\n      (a!2 (<= (mass (sel-Clipper (select heap 2))) 15)))\n  (and a!1 a!2)))\n(define-fun const-2-Clipper () Clipper\n  (mk-Clipper 10 12))\n(define-fun _xkassert4 () Bool\n  (let ((a!1 (forall ((mass Int) (bound Int))\n             (let ((a!1 (= bound (B (sel-ConservativeProof1 (select heap 3))))))\n               (=> (and (and (<= 10 mass) (<= mass 15)) a!1 (<= mass bound))\n                   (and (<= 10 mass) (<= mass 15)))))))\n  (= (pandq_impl_p (sel-ConservativeProof1 (select heap 3))) a!1)))\n(define-fun const-3-ConservativeProof1 () ConservativeProof1\n  (mk-ConservativeProof1 40 true false))\n(define-fun NULL$Ref () Int\n  (- 1))\n(define-fun _xkassert0 () Bool\n  (let ((a!1 (<= 10 (mass (sel-SC (select heap 1)))))\n      (a!2 (<= (mass (sel-SC (select heap 1))) 15)))\n  (and a!1 a!2)))",
