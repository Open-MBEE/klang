  "model": "\ndurations:Seq[Int]\n\npriorities:Seq[Int]\n\nreq durations.size >= 2\n\nreq durations.size <= 4\n\nreq priorities.size = durations.size\n\nreq durations.at(0) > 0\n\nreq durations.at(0) <= 100\n\nreq durations.at(1) > 0\n\nreq durations.at(1) <= 100\n\nreq priorities.at(0) >= 1\n\nreq priorities.at(0) <= 5\n\nreq priorities.at(1) >= 1\n\nreq priorities.at(1) <= 5\n\nreq durations.at(0) + durations.at(1) <= 150\n\nreq priorities.at(0) = 5 || priorities.at(1) = 5\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-datatypes () ((TopLevelDeclarations (mk-TopLevelDeclarations (durations (Seq Int))(priorities (Seq Int))))))\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-TopLevelDeclarations (sel-TopLevelDeclarations TopLevelDeclarations))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-TopLevelDeclarations ((this Ref)) Bool\n  (is-lift-TopLevelDeclarations (deref this))\n)\n\n(define-fun deref-TopLevelDeclarations ((this Ref)) TopLevelDeclarations\n  (sel-TopLevelDeclarations (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-TopLevelDeclarations ((this Ref)) Bool\n  (deref-is-TopLevelDeclarations this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; -------------------------------------------\n;   Getters for class TopLevelDeclarations:\n; -------------------------------------------\n\n; --- getters for TopLevelDeclarations.durations: ---\n\n(define-fun TopLevelDeclarations!durations ((this Ref)) (Seq Int)\n  (durations (deref-TopLevelDeclarations this))\n)\n\n; --- getters for TopLevelDeclarations.priorities: ---\n\n(define-fun TopLevelDeclarations!priorities ((this Ref)) (Seq Int)\n  (priorities (deref-TopLevelDeclarations this))\n)\n\n; ================\n; === Methods: ===\n; ================\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; ---------------------------------------------\n;   Invariant for class TopLevelDeclarations:\n; ---------------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-0-TopLevelDeclarations TopLevelDeclarations)\n\n; --- Invariant 1: ---\n\n(define-fun TopLevelDeclarations.inv1 ((this Ref)) Bool\n  (>= (seq.len (TopLevelDeclarations!durations this)) 2)\n)\n\n(assert (! (TopLevelDeclarations.inv1 0) :named _xkassert0))\n\n; --- Invariant 2: ---\n\n(define-fun TopLevelDeclarations.inv2 ((this Ref)) Bool\n  (<= (seq.len (TopLevelDeclarations!durations this)) 4)\n)\n\n(assert (! (TopLevelDeclarations.inv2 0) :named _xkassert1))\n\n; --- Invariant 3: ---\n\n(define-fun TopLevelDeclarations.inv3 ((this Ref)) Bool\n  (= (seq.len (TopLevelDeclarations!priorities this)) (seq.len (TopLevelDeclarations!durations this)))\n)\n\n(assert (! (TopLevelDeclarations.inv3 0) :named _xkassert2))\n\n; --- Invariant 4: ---\n\n(define-fun TopLevelDeclarations.inv4 ((this Ref)) Bool\n  (> (seq.nth (TopLevelDeclarations!durations this) 0) 0)\n)\n\n(assert (! (TopLevelDeclarations.inv4 0) :named _xkassert3))\n\n; --- Invariant 5: ---\n\n(define-fun TopLevelDeclarations.inv5 ((this Ref)) Bool\n  (<= (seq.nth (TopLevelDeclarations!durations this) 0) 100)\n)\n\n(assert (! (TopLevelDeclarations.inv5 0) :named _xkassert4))\n\n; --- Invariant 6: ---\n\n(define-fun TopLevelDeclarations.inv6 ((this Ref)) Bool\n  (> (seq.nth (TopLevelDeclarations!durations this) 1) 0)\n)\n\n(assert (! (TopLevelDeclarations.inv6 0) :named _xkassert5))\n\n; --- Invariant 7: ---\n\n(define-fun TopLevelDeclarations.inv7 ((this Ref)) Bool\n  (<= (seq.nth (TopLevelDeclarations!durations this) 1) 100)\n)\n\n(assert (! (TopLevelDeclarations.inv7 0) :named _xkassert6))\n\n; --- Invariant 8: ---\n\n(define-fun TopLevelDeclarations.inv8 ((this Ref)) Bool\n  (>= (seq.nth (TopLevelDeclarations!priorities this) 0) 1)\n)\n\n(assert (! (TopLevelDeclarations.inv8 0) :named _xkassert7))\n\n; --- Invariant 9: ---\n\n(define-fun TopLevelDeclarations.inv9 ((this Ref)) Bool\n  (<= (seq.nth (TopLevelDeclarations!priorities this) 0) 5)\n)\n\n(assert (! (TopLevelDeclarations.inv9 0) :named _xkassert8))\n\n; --- Invariant 10: ---\n\n(define-fun TopLevelDeclarations.inv10 ((this Ref)) Bool\n  (>= (seq.nth (TopLevelDeclarations!priorities this) 1) 1)\n)\n\n(assert (! (TopLevelDeclarations.inv10 0) :named _xkassert9))\n\n; --- Invariant 11: ---\n\n(define-fun TopLevelDeclarations.inv11 ((this Ref)) Bool\n  (<= (seq.nth (TopLevelDeclarations!priorities this) 1) 5)\n)\n\n(assert (! (TopLevelDeclarations.inv11 0) :named _xkassert10))\n\n; --- Invariant 12: ---\n\n(define-fun TopLevelDeclarations.inv12 ((this Ref)) Bool\n  (<= (+ (seq.nth (TopLevelDeclarations!durations this) 0) (seq.nth (TopLevelDeclarations!durations this) 1)) 150)\n)\n\n(assert (! (TopLevelDeclarations.inv12 0) :named _xkassert11))\n\n; --- Invariant 13: ---\n\n(define-fun TopLevelDeclarations.inv13 ((this Ref)) Bool\n  (or (= (seq.nth (TopLevelDeclarations!priorities this) 0) 5) (= (seq.nth (TopLevelDeclarations!priorities this) 1) 5))\n)\n\n(assert (! (TopLevelDeclarations.inv13 0) :named _xkassert12))\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store\n      ((as const (Array Ref Any)) null)\n        0 (lift-TopLevelDeclarations const-0-TopLevelDeclarations))\n  )\n)\n\n",
  "smtModel": "(define-fun const-0-TopLevelDeclarations () TopLevelDeclarations\n  (mk-TopLevelDeclarations\n  (seq.++ (seq.unit 5) (seq.unit 1))\n  (seq.++ (seq.unit 5) (seq.unit 1))))\n(define-fun _xkassert7 () Bool\n  (let ((a!1 (seq.nth (priorities (sel-TopLevelDeclarations (select heap 0))) 0)))\n  (>= a!1 1)))\n(define-fun _xkassert2 () Bool\n  (let ((a!1 (seq.len (priorities (sel-TopLevelDeclarations (select heap 0)))))\n      (a!2 (seq.len (durations (sel-TopLevelDeclarations (select heap 0))))))\n  (= a!1 a!2)))\n(define-fun _xkassert5 () Bool\n  (let ((a!1 (seq.nth (durations (sel-TopLevelDeclarations (select heap 0))) 1)))\n  (> a!1 0)))\n(define-fun _xkassert9 () Bool\n  (let ((a!1 (seq.nth (priorities (sel-TopLevelDeclarations (select heap 0))) 1)))\n  (>= a!1 1)))\n(define-fun _xkassert0 () Bool\n  (let ((a!1 (seq.len (durations (sel-TopLevelDeclarations (select heap 0))))))\n  (>= a!1 2)))\n(define-fun _xkassert8 () Bool\n  (let ((a!1 (seq.nth (priorities (sel-TopLevelDeclarations (select heap 0))) 0)))\n  (<= a!1 5)))\n(define-fun _xkassert10 () Bool\n  (let ((a!1 (seq.nth (priorities (sel-TopLevelDeclarations (select heap 0))) 1)))\n  (<= a!1 5)))\n(define-fun _xkassert12 () Bool\n  (let ((a!1 (seq.nth (priorities (sel-TopLevelDeclarations (select heap 0))) 0))\n      (a!2 (seq.nth (priorities (sel-TopLevelDeclarations (select heap 0))) 1)))\n  (or (= a!1 5) (= a!2 5))))\n(define-fun _xkassert3 () Bool\n  (let ((a!1 (seq.nth (durations (sel-TopLevelDeclarations (select heap 0))) 0)))\n  (> a!1 0)))\n(define-fun _xkassert11 () Bool\n  (let ((a!1 (seq.nth (durations (sel-TopLevelDeclarations (select heap 0))) 0))\n      (a!2 (seq.nth (durations (sel-TopLevelDeclarations (select heap 0))) 1)))\n  (<= (+ a!1 a!2) 150)))\n(define-fun _xkassert6 () Bool\n  (let ((a!1 (seq.nth (durations (sel-TopLevelDeclarations (select heap 0))) 1)))\n  (<= a!1 100)))\n(define-fun _xkassert1 () Bool\n  (let ((a!1 (seq.len (durations (sel-TopLevelDeclarations (select heap 0))))))\n  (<= a!1 4)))\n(define-fun _xkassert4 () Bool\n  (let ((a!1 (seq.nth (durations (sel-TopLevelDeclarations (select heap 0))) 0)))\n  (<= a!1 100)))\n(define-fun NULL$Ref () Int\n  (- 1))\n(define-fun heap () (Array Int Any)\n  (let ((a!1 (lift-TopLevelDeclarations\n             (mk-TopLevelDeclarations\n               (seq.++ (seq.unit 5) (seq.unit 1))\n               (seq.++ (seq.unit 5) (seq.unit 1))))))\n  (store ((as const (Array Int Any)) null) 0 a!1)))\n(define-fun seq.nth_u ((x!0 (Seq Int)) (x!1 Int)) Int\n  (ite (and (= x!0 (seq.++ (seq.unit 5) (seq.unit 1))) (= x!1 1)) 4\n    3))",
