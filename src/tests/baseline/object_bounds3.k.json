  "model": "\nvalues:Seq[Int]\n\nreq values.size > 2\n\nreq values.size < 10\n\nreq values.at(0) > 0 && values.at(0) < 3\n\nreq values.at(1) > 0 && values.at(1) < 3\n\nreq values.at(2) > 0 && values.at(2) < 3\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-datatypes () ((TopLevelDeclarations (mk-TopLevelDeclarations (values (Seq Int))))))\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-TopLevelDeclarations (sel-TopLevelDeclarations TopLevelDeclarations))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-TopLevelDeclarations ((this Ref)) Bool\n  (is-lift-TopLevelDeclarations (deref this))\n)\n\n(define-fun deref-TopLevelDeclarations ((this Ref)) TopLevelDeclarations\n  (sel-TopLevelDeclarations (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-TopLevelDeclarations ((this Ref)) Bool\n  (deref-is-TopLevelDeclarations this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; -------------------------------------------\n;   Getters for class TopLevelDeclarations:\n; -------------------------------------------\n\n; --- getters for TopLevelDeclarations.values: ---\n\n(define-fun TopLevelDeclarations!values ((this Ref)) (Seq Int)\n  (values (deref-TopLevelDeclarations this))\n)\n\n; ================\n; === Methods: ===\n; ================\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; ---------------------------------------------\n;   Invariant for class TopLevelDeclarations:\n; ---------------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-0-TopLevelDeclarations TopLevelDeclarations)\n\n; --- Invariant 1: ---\n\n(define-fun TopLevelDeclarations.inv1 ((this Ref)) Bool\n  (> (seq.len (TopLevelDeclarations!values this)) 2)\n)\n\n(assert (! (TopLevelDeclarations.inv1 0) :named _xkassert0))\n\n; --- Invariant 2: ---\n\n(define-fun TopLevelDeclarations.inv2 ((this Ref)) Bool\n  (< (seq.len (TopLevelDeclarations!values this)) 10)\n)\n\n(assert (! (TopLevelDeclarations.inv2 0) :named _xkassert1))\n\n; --- Invariant 3: ---\n\n(define-fun TopLevelDeclarations.inv3 ((this Ref)) Bool\n  (and (> (seq.nth (TopLevelDeclarations!values this) 0) 0) (< (seq.nth (TopLevelDeclarations!values this) 0) 3))\n)\n\n(assert (! (TopLevelDeclarations.inv3 0) :named _xkassert2))\n\n; --- Invariant 4: ---\n\n(define-fun TopLevelDeclarations.inv4 ((this Ref)) Bool\n  (and (> (seq.nth (TopLevelDeclarations!values this) 1) 0) (< (seq.nth (TopLevelDeclarations!values this) 1) 3))\n)\n\n(assert (! (TopLevelDeclarations.inv4 0) :named _xkassert3))\n\n; --- Invariant 5: ---\n\n(define-fun TopLevelDeclarations.inv5 ((this Ref)) Bool\n  (and (> (seq.nth (TopLevelDeclarations!values this) 2) 0) (< (seq.nth (TopLevelDeclarations!values this) 2) 3))\n)\n\n(assert (! (TopLevelDeclarations.inv5 0) :named _xkassert4))\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store\n      ((as const (Array Ref Any)) null)\n        0 (lift-TopLevelDeclarations const-0-TopLevelDeclarations))\n  )\n)\n\n",
  "smtModel": "(define-fun const-0-TopLevelDeclarations () TopLevelDeclarations\n  (mk-TopLevelDeclarations (seq.++ (seq.unit 2) (seq.unit 2) (seq.unit 2))))\n(define-fun _xkassert2 () Bool\n  (let ((a!1 (seq.nth (values (sel-TopLevelDeclarations (select heap 0))) 0)))\n  (and (> a!1 0) (< a!1 3))))\n(define-fun _xkassert3 () Bool\n  (let ((a!1 (seq.nth (values (sel-TopLevelDeclarations (select heap 0))) 1)))\n  (and (> a!1 0) (< a!1 3))))\n(define-fun _xkassert0 () Bool\n  (let ((a!1 (seq.len (values (sel-TopLevelDeclarations (select heap 0))))))\n  (> a!1 2)))\n(define-fun _xkassert1 () Bool\n  (let ((a!1 (seq.len (values (sel-TopLevelDeclarations (select heap 0))))))\n  (< a!1 10)))\n(define-fun _xkassert4 () Bool\n  (let ((a!1 (seq.nth (values (sel-TopLevelDeclarations (select heap 0))) 2)))\n  (and (> a!1 0) (< a!1 3))))\n(define-fun NULL$Ref () Int\n  (- 1))\n(define-fun heap () (Array Int Any)\n  (let ((a!1 (lift-TopLevelDeclarations\n             (mk-TopLevelDeclarations\n               (seq.++ (seq.unit 2) (seq.unit 2) (seq.unit 2))))))\n  (store ((as const (Array Int Any)) null) 0 a!1)))\n(define-fun seq.nth_u ((x!0 (Seq Int)) (x!1 Int)) Int\n  (ite (and (= x!0 (seq.++ (seq.unit 2) (seq.unit 2) (seq.unit 2))) (= x!1 1)) 5\n    4))",
