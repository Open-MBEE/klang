  "model": "\nclass StringOps1 {\n  text:String\n\n  req text = \"ABCDEF\"\n  len:Int\n\n  req len = text.length\n\n  req len = 6\n  sub1:String\n\n  req sub1 = text.substring(0,3)\n\n  req sub1 = \"ABC\"\n  sub2:String\n\n  req sub2 = text.substring(2,5)\n\n  req sub2 = \"CDE\"\n  ch0:String\n\n  req ch0 = text.charAt(0)\n\n  req ch0 = \"A\"\n  ch3:String\n\n  req ch3 = text.charAt(3)\n\n  req ch3 = \"D\"\n}\n\nmain:StringOps1\n\n",
