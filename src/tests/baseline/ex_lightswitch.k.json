  "model": "\nclass State\n\nclass LightSwitchSpec {\n  off:State\n  on:State\n\n  req off != on\n\n  fun toggle(state:State) : State\n\n\n  req toggle(off) = on\n\n  req toggle(on) = off\n\n  fun isOn(state:State) : Bool\n  {\n    state = on\n  }\n}\n\nclass LightSwitchImpl {\n\n  fun toggle(state:Int) : Int\n    post $result = 0 || $result = 1\n  {\n    if state = 1 then\n      0\n    else\n      1\n  }\n\n  fun isOn(state:Int) : Bool\n  {\n    state = 1\n  }\n}\n\nclass Main {\n  abstract:LightSwitchSpec\n  concrete:LightSwitchImpl\n\n  fun abs(concrete:Int) : State\n  {\n    if concrete = 1 then\n      abstract.on\n    else\n      abstract.off\n  }\n\n  req forall concreteState : Int . abstract.toggle(abs(concreteState)) = abs(concrete.toggle(concreteState))\n}\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-sort State) (declare-const mk-State State)\n(declare-datatypes () ((LightSwitchSpec (mk-LightSwitchSpec (off Ref)(on Ref)))))\n(declare-sort LightSwitchImpl) (declare-const mk-LightSwitchImpl LightSwitchImpl)\n(declare-datatypes () ((Main (mk-Main (abstract Ref)(concrete Ref)))))\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-State (sel-State State))\n  (lift-LightSwitchSpec (sel-LightSwitchSpec LightSwitchSpec))\n  (lift-LightSwitchImpl (sel-LightSwitchImpl LightSwitchImpl))\n  (lift-Main (sel-Main Main))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-State ((this Ref)) Bool\n  (is-lift-State (deref this))\n)\n\n(define-fun deref-State ((this Ref)) State\n  (sel-State (deref this))\n)\n\n(define-fun deref-is-LightSwitchSpec ((this Ref)) Bool\n  (is-lift-LightSwitchSpec (deref this))\n)\n\n(define-fun deref-LightSwitchSpec ((this Ref)) LightSwitchSpec\n  (sel-LightSwitchSpec (deref this))\n)\n\n(define-fun deref-is-LightSwitchImpl ((this Ref)) Bool\n  (is-lift-LightSwitchImpl (deref this))\n)\n\n(define-fun deref-LightSwitchImpl ((this Ref)) LightSwitchImpl\n  (sel-LightSwitchImpl (deref this))\n)\n\n(define-fun deref-is-Main ((this Ref)) Bool\n  (is-lift-Main (deref this))\n)\n\n(define-fun deref-Main ((this Ref)) Main\n  (sel-Main (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-State ((this Ref)) Bool\n  (deref-is-State this)\n)\n\n(define-fun deref-isa-LightSwitchSpec ((this Ref)) Bool\n  (deref-is-LightSwitchSpec this)\n)\n\n(define-fun deref-isa-LightSwitchImpl ((this Ref)) Bool\n  (deref-is-LightSwitchImpl this)\n)\n\n(define-fun deref-isa-Main ((this Ref)) Bool\n  (deref-is-Main this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; --------------------------------------\n;   Getters for class LightSwitchSpec:\n; --------------------------------------\n\n; --- getters for LightSwitchSpec.off: ---\n\n(define-fun LightSwitchSpec.off ((this Ref)) Ref\n  (off (deref-LightSwitchSpec this))\n)\n\n(define-fun LightSwitchSpec!off ((this Ref)) Ref\n  (off (deref-LightSwitchSpec this))\n)\n\n; --- getters for LightSwitchSpec.on: ---\n\n(define-fun LightSwitchSpec.on ((this Ref)) Ref\n  (on (deref-LightSwitchSpec this))\n)\n\n(define-fun LightSwitchSpec!on ((this Ref)) Ref\n  (on (deref-LightSwitchSpec this))\n)\n\n; ---------------------------\n;   Getters for class Main:\n; ---------------------------\n\n; --- getters for Main.abstract: ---\n\n(define-fun Main.abstract ((this Ref)) Ref\n  (abstract (deref-Main this))\n)\n\n(define-fun Main!abstract ((this Ref)) Ref\n  (abstract (deref-Main this))\n)\n\n; --- getters for Main.concrete: ---\n\n(define-fun Main!concrete ((this Ref)) Ref\n  (concrete (deref-Main this))\n)\n\n; ================\n; === Methods: ===\n; ================\n\n; --------------------------------------\n;   Methods for class LightSwitchSpec:\n; --------------------------------------\n\n(declare-fun LightSwitchSpec.toggle (Ref Ref) Ref)\n\n(define-fun LightSwitchSpec!toggle ((this Ref)(state Ref)) Ref\n  (LightSwitchSpec.toggle this state)\n)\n\n(define-fun LightSwitchSpec.isOn ((this Ref)(state Ref)) Bool\n  (= state (LightSwitchSpec.on this))\n)\n\n(define-fun LightSwitchSpec!isOn ((this Ref)(state Ref)) Bool\n  (= state (LightSwitchSpec!on this))\n)\n\n; --------------------------------------\n;   Methods for class LightSwitchImpl:\n; --------------------------------------\n\n(define-fun LightSwitchImpl.toggle ((this Ref)(state Int)) Int\n  (ite (= state 1) 0 1)\n)\n\n(define-fun LightSwitchImpl!toggle ((this Ref)(state Int)) Int\n  (ite (= state 1) 0 1)\n)\n\n(assert (!(forall ((this Ref)(state Int))\n  (=>\n    (and\n      (deref-is-LightSwitchImpl this)\n    )\n    (let (($result (LightSwitchImpl!toggle this state)))\n      (and\n        (or (= $result 0) (= $result 1))\n      )\n    )\n  )\n) :named _xkassert0))\n\n(define-fun LightSwitchImpl.isOn ((this Ref)(state Int)) Bool\n  (= state 1)\n)\n\n(define-fun LightSwitchImpl!isOn ((this Ref)(state Int)) Bool\n  (= state 1)\n)\n\n; ---------------------------\n;   Methods for class Main:\n; ---------------------------\n\n(define-fun Main.abs ((this Ref)(concrete Int)) Ref\n  (ite (= concrete 1) (LightSwitchSpec.on (Main.abstract this)) (LightSwitchSpec.off (Main.abstract this)))\n)\n\n(define-fun Main!abs ((this Ref)(concrete Int)) Ref\n  (ite (= concrete 1) (LightSwitchSpec.on (Main!abstract this)) (LightSwitchSpec.off (Main!abstract this)))\n)\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; ------------------------------\n;   Invariant for class State:\n; ------------------------------\n\n; --- Constants: ---\n\n(declare-const const-1-State State)\n(declare-const const-2-State State)\n\n\n\n; ----------------------------------------\n;   Invariant for class LightSwitchSpec:\n; ----------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-3-LightSwitchSpec LightSwitchSpec)\n\n; --- Invariant 1: ---\n\n(define-fun LightSwitchSpec.inv1 ((this Ref)) Bool\n  (deref-isa-State (LightSwitchSpec!off this))\n)\n\n(assert (! (LightSwitchSpec.inv1 3) :named _xkassert1))\n\n; --- Invariant 2: ---\n\n(define-fun LightSwitchSpec.inv2 ((this Ref)) Bool\n  (deref-isa-State (LightSwitchSpec!on this))\n)\n\n(assert (! (LightSwitchSpec.inv2 3) :named _xkassert2))\n\n; --- Invariant 3: ---\n\n(define-fun LightSwitchSpec.inv3 ((this Ref)) Bool\n  (not (= (LightSwitchSpec!off this) (LightSwitchSpec!on this)))\n)\n\n(assert (! (LightSwitchSpec.inv3 3) :named _xkassert3))\n\n; --- Invariant 4: ---\n\n(define-fun LightSwitchSpec.inv4 ((this Ref)) Bool\n  (= (LightSwitchSpec!toggle this (LightSwitchSpec!off this)) (LightSwitchSpec!on this))\n)\n\n(assert (! (LightSwitchSpec.inv4 3) :named _xkassert4))\n\n; --- Invariant 5: ---\n\n(define-fun LightSwitchSpec.inv5 ((this Ref)) Bool\n  (= (LightSwitchSpec!toggle this (LightSwitchSpec!on this)) (LightSwitchSpec!off this))\n)\n\n(assert (! (LightSwitchSpec.inv5 3) :named _xkassert5))\n\n\n\n; ----------------------------------------\n;   Invariant for class LightSwitchImpl:\n; ----------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-4-LightSwitchImpl LightSwitchImpl)\n\n\n\n; -----------------------------\n;   Invariant for class Main:\n; -----------------------------\n\n; --- Constants: ---\n\n(declare-const const-5-Main Main)\n\n; --- Invariant 1: ---\n\n(define-fun Main.inv1 ((this Ref)) Bool\n  (deref-isa-LightSwitchSpec (Main!abstract this))\n)\n\n(assert (! (Main.inv1 5) :named _xkassert6))\n\n; --- Invariant 2: ---\n\n(define-fun Main.inv2 ((this Ref)) Bool\n  (deref-isa-LightSwitchImpl (Main!concrete this))\n)\n\n(assert (! (Main.inv2 5) :named _xkassert7))\n\n; --- Invariant 3: ---\n\n(define-fun Main.inv3 ((this Ref)) Bool\n  (forall ((concreteState Int)) (= (LightSwitchSpec.toggle (Main!abstract this) (Main!abs this concreteState)) (Main!abs this (LightSwitchImpl.toggle (Main!concrete this) concreteState))))\n)\n\n(assert (! (Main.inv3 5) :named _xkassert8))\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store(store(store(store(store\n      ((as const (Array Ref Any)) null)\n        1 (lift-State const-1-State))\n        2 (lift-State const-2-State))\n        3 (lift-LightSwitchSpec const-3-LightSwitchSpec))\n        4 (lift-LightSwitchImpl const-4-LightSwitchImpl))\n        5 (lift-Main const-5-Main))\n  )\n)\n\n",
  "smtModel": ";; universe for State:\n;;   State!val!1 State!val!0 \n;; -----------\n;; definitions for universe elements:\n(declare-fun State!val!1 () State)\n(declare-fun State!val!0 () State)\n;; cardinality constraint:\n(forall ((x State)) (or (= x State!val!1) (= x State!val!0)))\n;; -----------\n;; universe for LightSwitchImpl:\n;;   LightSwitchImpl!val!0 \n;; -----------\n;; definitions for universe elements:\n(declare-fun LightSwitchImpl!val!0 () LightSwitchImpl)\n;; cardinality constraint:\n(forall ((x LightSwitchImpl)) (= x LightSwitchImpl!val!0))\n;; -----------\n(define-fun const-5-Main () Main\n  (mk-Main 3 4))\n(define-fun const-3-LightSwitchSpec () LightSwitchSpec\n  (mk-LightSwitchSpec 1 2))\n(define-fun const-2-State () State\n  State!val!1)\n(define-fun const-4-LightSwitchImpl () LightSwitchImpl\n  LightSwitchImpl!val!0)\n(define-fun const-1-State () State\n  State!val!0)\n(define-fun _xkassert4 () Bool\n  (let ((a!1 (LightSwitchSpec.toggle\n             3\n             (off (sel-LightSwitchSpec (select heap 3))))))\n  (= a!1 (on (sel-LightSwitchSpec (select heap 3))))))\n(define-fun _xkassert6 () Bool\n  (let ((a!1 (select heap (abstract (sel-Main (select heap 5))))))\n  (is-lift-LightSwitchSpec a!1)))\n(define-fun _xkassert2 () Bool\n  (let ((a!1 (select heap (on (sel-LightSwitchSpec (select heap 3))))))\n  (is-lift-State a!1)))\n(define-fun _xkassert5 () Bool\n  (let ((a!1 (LightSwitchSpec.toggle 3 (on (sel-LightSwitchSpec (select heap 3))))))\n  (= a!1 (off (sel-LightSwitchSpec (select heap 3))))))\n(define-fun _xkassert7 () Bool\n  (let ((a!1 (select heap (concrete (sel-Main (select heap 5))))))\n  (is-lift-LightSwitchImpl a!1)))\n(define-fun _xkassert0 () Bool\n  (forall ((this Int) (state Int))\n  (let ((a!1 (or (= (ite (= state 1) 0 1) 0) (= (ite (= state 1) 0 1) 1))))\n    (=> (and (is-lift-LightSwitchImpl (select heap this))) (and a!1)))))\n(define-fun _xkassert8 () Bool\n  (forall ((concreteState Int))\n  (let ((a!1 (select heap (abstract (sel-Main (select heap 5))))))\n  (let ((a!2 (LightSwitchSpec.toggle\n               (abstract (sel-Main (select heap 5)))\n               (ite (= concreteState 1)\n                    (on (sel-LightSwitchSpec a!1))\n                    (off (sel-LightSwitchSpec a!1)))))\n        (a!3 (ite (= (ite (= concreteState 1) 0 1) 1)\n                  (on (sel-LightSwitchSpec a!1))\n                  (off (sel-LightSwitchSpec a!1)))))\n    (= a!2 a!3)))))\n(define-fun _xkassert3 () Bool\n  (let ((a!1 (= (off (sel-LightSwitchSpec (select heap 3)))\n              (on (sel-LightSwitchSpec (select heap 3))))))\n  (not a!1)))\n(define-fun _xkassert1 () Bool\n  (let ((a!1 (select heap (off (sel-LightSwitchSpec (select heap 3))))))\n  (is-lift-State a!1)))\n(define-fun NULL$Ref () Int\n  (- 1))\n(define-fun heap () (Array Int Any)\n  (let ((a!1 (store (store (store ((as const (Array Int Any)) null)\n                                1\n                                (lift-State State!val!0))\n                         2\n                         (lift-State State!val!1))\n                  3\n                  (lift-LightSwitchSpec (mk-LightSwitchSpec 1 2)))))\n  (store (store a!1 4 (lift-LightSwitchImpl LightSwitchImpl!val!0))\n         5\n         (lift-Main (mk-Main 3 4)))))\n(define-fun LightSwitchSpec.toggle ((x!0 Int) (x!1 Int)) Int\n  (ite (and (= x!0 3) (= x!1 2)) 1\n    2))",
