  "model": "\n@timeout(100)\n@bestEffort(null)\n\nclass HardProblem2 {\n  a:Int\n  b:Int\n  c:Int\n  d:Int\n  e:Int\n\n  req a >= 1 && a <= 1000\n\n  req b >= 1 && b <= 1000\n\n  req c >= 1 && c <= 1000\n\n  req d >= 1 && d <= 1000\n\n  req e >= 1 && e <= 1000\n\n  req a * b + c * d = e * 100\n\n  req a * c = b * d + 50\n\n  req (a + b) * (c + d) >= e * 10\n\n  req a + b + c + d + e = 500\n\n  req a * a + b * b < c * c + d * d\n\n  req e > a && e > b\n  maximize e\n}\n\nmain:HardProblem2\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-datatypes () ((TopLevelDeclarations (mk-TopLevelDeclarations (main Ref)))))\n(declare-datatypes () ((HardProblem2 (mk-HardProblem2 (a Int)(b Int)(c Int)(d Int)(e Int)))))\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-TopLevelDeclarations (sel-TopLevelDeclarations TopLevelDeclarations))\n  (lift-HardProblem2 (sel-HardProblem2 HardProblem2))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-TopLevelDeclarations ((this Ref)) Bool\n  (is-lift-TopLevelDeclarations (deref this))\n)\n\n(define-fun deref-TopLevelDeclarations ((this Ref)) TopLevelDeclarations\n  (sel-TopLevelDeclarations (deref this))\n)\n\n(define-fun deref-is-HardProblem2 ((this Ref)) Bool\n  (is-lift-HardProblem2 (deref this))\n)\n\n(define-fun deref-HardProblem2 ((this Ref)) HardProblem2\n  (sel-HardProblem2 (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-TopLevelDeclarations ((this Ref)) Bool\n  (deref-is-TopLevelDeclarations this)\n)\n\n(define-fun deref-isa-HardProblem2 ((this Ref)) Bool\n  (deref-is-HardProblem2 this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; -------------------------------------------\n;   Getters for class TopLevelDeclarations:\n; -------------------------------------------\n\n; --- getters for TopLevelDeclarations.main: ---\n\n(define-fun TopLevelDeclarations!main ((this Ref)) Ref\n  (main (deref-TopLevelDeclarations this))\n)\n\n; -----------------------------------\n;   Getters for class HardProblem2:\n; -----------------------------------\n\n; --- getters for HardProblem2.a: ---\n\n(define-fun HardProblem2!a ((this Ref)) Int\n  (a (deref-HardProblem2 this))\n)\n\n; --- getters for HardProblem2.b: ---\n\n(define-fun HardProblem2!b ((this Ref)) Int\n  (b (deref-HardProblem2 this))\n)\n\n; --- getters for HardProblem2.c: ---\n\n(define-fun HardProblem2!c ((this Ref)) Int\n  (c (deref-HardProblem2 this))\n)\n\n; --- getters for HardProblem2.d: ---\n\n(define-fun HardProblem2!d ((this Ref)) Int\n  (d (deref-HardProblem2 this))\n)\n\n; --- getters for HardProblem2.e: ---\n\n(define-fun HardProblem2!e ((this Ref)) Int\n  (e (deref-HardProblem2 this))\n)\n\n; ================\n; === Methods: ===\n; ================\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; ---------------------------------------------\n;   Invariant for class TopLevelDeclarations:\n; ---------------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-0-TopLevelDeclarations TopLevelDeclarations)\n\n; --- Invariant 1: ---\n\n(define-fun TopLevelDeclarations.inv1 ((this Ref)) Bool\n  (deref-isa-HardProblem2 (TopLevelDeclarations!main this))\n)\n\n(assert (! (TopLevelDeclarations.inv1 0) :named _xkassert0))\n\n\n\n; -------------------------------------\n;   Invariant for class HardProblem2:\n; -------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-1-HardProblem2 HardProblem2)\n\n; --- Invariant 1: ---\n\n(define-fun HardProblem2.inv1 ((this Ref)) Bool\n  (and (>= (HardProblem2!a this) 1) (<= (HardProblem2!a this) 1000))\n)\n\n(assert (! (HardProblem2.inv1 1) :named _xkassert1))\n\n; --- Invariant 2: ---\n\n(define-fun HardProblem2.inv2 ((this Ref)) Bool\n  (and (>= (HardProblem2!b this) 1) (<= (HardProblem2!b this) 1000))\n)\n\n(assert (! (HardProblem2.inv2 1) :named _xkassert2))\n\n; --- Invariant 3: ---\n\n(define-fun HardProblem2.inv3 ((this Ref)) Bool\n  (and (>= (HardProblem2!c this) 1) (<= (HardProblem2!c this) 1000))\n)\n\n(assert (! (HardProblem2.inv3 1) :named _xkassert3))\n\n; --- Invariant 4: ---\n\n(define-fun HardProblem2.inv4 ((this Ref)) Bool\n  (and (>= (HardProblem2!d this) 1) (<= (HardProblem2!d this) 1000))\n)\n\n(assert (! (HardProblem2.inv4 1) :named _xkassert4))\n\n; --- Invariant 5: ---\n\n(define-fun HardProblem2.inv5 ((this Ref)) Bool\n  (and (>= (HardProblem2!e this) 1) (<= (HardProblem2!e this) 1000))\n)\n\n(assert (! (HardProblem2.inv5 1) :named _xkassert5))\n\n; --- Invariant 6: ---\n\n(define-fun HardProblem2.inv6 ((this Ref)) Bool\n  (= (+ (* (HardProblem2!a this) (HardProblem2!b this)) (* (HardProblem2!c this) (HardProblem2!d this))) (* (HardProblem2!e this) 100))\n)\n\n(assert (! (HardProblem2.inv6 1) :named _xkassert6))\n\n; --- Invariant 7: ---\n\n(define-fun HardProblem2.inv7 ((this Ref)) Bool\n  (= (* (HardProblem2!a this) (HardProblem2!c this)) (+ (* (HardProblem2!b this) (HardProblem2!d this)) 50))\n)\n\n(assert (! (HardProblem2.inv7 1) :named _xkassert7))\n\n; --- Invariant 8: ---\n\n(define-fun HardProblem2.inv8 ((this Ref)) Bool\n  (>= (* (+ (HardProblem2!a this) (HardProblem2!b this)) (+ (HardProblem2!c this) (HardProblem2!d this))) (* (HardProblem2!e this) 10))\n)\n\n(assert (! (HardProblem2.inv8 1) :named _xkassert8))\n\n; --- Invariant 9: ---\n\n(define-fun HardProblem2.inv9 ((this Ref)) Bool\n  (= (+ (+ (+ (+ (HardProblem2!a this) (HardProblem2!b this)) (HardProblem2!c this)) (HardProblem2!d this)) (HardProblem2!e this)) 500)\n)\n\n(assert (! (HardProblem2.inv9 1) :named _xkassert9))\n\n; --- Invariant 10: ---\n\n(define-fun HardProblem2.inv10 ((this Ref)) Bool\n  (< (+ (* (HardProblem2!a this) (HardProblem2!a this)) (* (HardProblem2!b this) (HardProblem2!b this))) (+ (* (HardProblem2!c this) (HardProblem2!c this)) (* (HardProblem2!d this) (HardProblem2!d this))))\n)\n\n(assert (! (HardProblem2.inv10 1) :named _xkassert10))\n\n; --- Invariant 11: ---\n\n(define-fun HardProblem2.inv11 ((this Ref)) Bool\n  (and (> (HardProblem2!e this) (HardProblem2!a this)) (> (HardProblem2!e this) (HardProblem2!b this)))\n)\n\n(assert (! (HardProblem2.inv11 1) :named _xkassert11))\n\n; --- Optimization Objectives (informational): ---\n\n; (maximize (HardProblem2!e this))\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store(store\n      ((as const (Array Ref Any)) null)\n        0 (lift-TopLevelDeclarations const-0-TopLevelDeclarations))\n        1 (lift-HardProblem2 const-1-HardProblem2))\n  )\n)\n\n",
  "smtModel": "(define-fun NULL$Ref () Int\n  0)\n(define-fun heap () (Array Int Any)\n  ((as const (Array Int Any)) null))\n(define-fun const-0-TopLevelDeclarations () TopLevelDeclarations\n  (mk-TopLevelDeclarations 0))\n(define-fun const-1-HardProblem2 () HardProblem2\n  (mk-HardProblem2 0 0 0 0 0))",
