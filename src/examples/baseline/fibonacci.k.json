  "model": "\npackage nasa.jpl.k.fibonacci {\n\nfun fib(n:Int) : Int\n\n\nreq C_Fib: forall x : Int . fib(x) > 0\n\nfun helper(x:Int) : Int\n{\n  req C0: x > 0\n  x + 1\n}\n\nfun swap(x:Int,y:Int) : (Int * Int)\n{\n  val g:Int\n  val t:Int = x\n  val nx:Int = y\n  val ny:Int = t\n  Tuple(nx,ny)\n}\n\nfun f : Set[Int]\n{\n  Set{1,2,3}\n}\n\n\n}\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-datatypes () ((TopLevelDeclarations (mk-TopLevelDeclarations (x Int)))))\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-TopLevelDeclarations (sel-TopLevelDeclarations TopLevelDeclarations))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-TopLevelDeclarations ((this Ref)) Bool\n  (is-lift-TopLevelDeclarations (deref this))\n)\n\n(define-fun deref-TopLevelDeclarations ((this Ref)) TopLevelDeclarations\n  (sel-TopLevelDeclarations (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-TopLevelDeclarations ((this Ref)) Bool\n  (deref-is-TopLevelDeclarations this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; ================\n; === Methods: ===\n; ================\n\n; -------------------------------------------\n;   Methods for class TopLevelDeclarations:\n; -------------------------------------------\n\n(declare-fun TopLevelDeclarations.fib (Ref Int) Int)\n\n(define-fun TopLevelDeclarations!fib ((this Ref)(n Int)) Int\n  (TopLevelDeclarations.fib this n)\n)\n\n(define-fun TopLevelDeclarations.helper ((this Ref)(x Int)) Int\n  (+ x 1)\n)\n\n(define-fun TopLevelDeclarations!helper ((this Ref)(x Int)) Int\n  (+ x 1)\n)\n\n(define-fun TopLevelDeclarations.swap ((this Ref)(x Int)(y Int)) (Tuple2 Int Int)\n  (let ((g 0))\n    (let ((t x))\n      (let ((nx y))\n        (let ((ny t))\n          (mk-Tuple2 nx ny)))))\n)\n\n(define-fun TopLevelDeclarations!swap ((this Ref)(x Int)(y Int)) (Tuple2 Int Int)\n  (let ((g 0))\n    (let ((t x))\n      (let ((nx y))\n        (let ((ny t))\n          (mk-Tuple2 nx ny)))))\n)\n\n(define-fun TopLevelDeclarations.f ((this Ref)) (Set Int)\n  (store (store (store ((as const (Set Int)) false) 1 true) 2 true) 3 true)\n)\n\n(define-fun TopLevelDeclarations!f ((this Ref)) (Set Int)\n  (store (store (store ((as const (Set Int)) false) 1 true) 2 true) 3 true)\n)\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; ---------------------------------------------\n;   Invariant for class TopLevelDeclarations:\n; ---------------------------------------------\n\n; --- Constants: ---\n\n(declare-const const-0-TopLevelDeclarations TopLevelDeclarations)\n\n; --- Invariant 1: ---\n\n(define-fun TopLevelDeclarations.inv1 ((this Ref)) Bool\n  (forall ((x Int)) (> (TopLevelDeclarations!fib this x) 0))\n)\n\n(assert (! (TopLevelDeclarations.inv1 0) :named _xkassert0))\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store\n      ((as const (Array Ref Any)) null)\n        0 (lift-TopLevelDeclarations const-0-TopLevelDeclarations))\n  )\n)\n\n; =================================\n; === Synthetic Function Calls: ===\n; =================================\n\n; Functions declared but never called - synthetic calls to check body constraints\n\n(declare-const _synth_helper_x Int)\n(assert (! (> _synth_helper_x 0) :named _xkassert1))\n\n",
  "smtModel": "(define-fun _xkassert1 () Bool\n  (> _synth_helper_x 0))\n(define-fun _synth_helper_x () Int\n  1)\n(define-fun _xkassert0 () Bool\n  (forall ((x Int)) (> (TopLevelDeclarations.fib 0 x) 0)))\n(define-fun NULL$Ref () Int\n  (- 1))\n(define-fun const-0-TopLevelDeclarations () TopLevelDeclarations\n  (mk-TopLevelDeclarations 0))\n(define-fun heap () (Array Int Any)\n  (store ((as const (Array Int Any)) null)\n       0\n       (lift-TopLevelDeclarations (mk-TopLevelDeclarations 0))))\n(define-fun TopLevelDeclarations.fib ((x!0 Int) (x!1 Int)) Int\n  1)",
