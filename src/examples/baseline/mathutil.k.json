  "model": "\nclass MathUtil {\n\n  fun min(x:Int,y:Int) : Int\n    post ($result = x || $result = y) && ($result <= x && $result <= y)\n  {\n    if x <= y then\n      x\n    else\n      y\n  }\n\n  fun max(x:Int,y:Int) : Int\n\n\n  fun abs(x:Int) : Int\n    post $result >= 0 && ($result = x || $result = -x)\n  {\n    if x < 0 then\n      -x\n    else\n      x\n  }\n}\n\n",
  "smt": "; ================\n; === Options: ===\n; ================\n\n(set-option :smt.macro-finder true)\n\n; ======================\n; === String Theory: ===\n; ======================\n\n; Z3 4.13.0+ requires explicit logic or theory declaration for strings\n(set-logic ALL)\n\n; ===========================\n; === Built-in datatypes: ===\n; ===========================\n\n(define-sort Ref () Int)\n\n(declare-datatypes (T1 T2) ((Tuple2 (mk-Tuple2 (_1 T1)(_2 T2)))))\n(declare-datatypes (T1 T2 T3) ((Tuple3 (mk-Tuple3 (_1 T1)(_2 T2)(_3 T3)))))\n\n\n; ===============================\n; === User-defined datatypes: ===\n; ===============================\n\n(declare-sort MathUtil) (declare-const mk-MathUtil MathUtil)\n\n; =============\n; === Heap: ===\n; =============\n\n(declare-datatypes () ((Any\n  (lift-MathUtil (sel-MathUtil MathUtil))\n  null))\n)\n\n(declare-const heap (Array Ref Any))\n(declare-const NULL$ String)\n(declare-const NULL$Ref Ref)\n(assert (= NULL$Ref (- 1)))\n\n(define-fun deref ((ref Ref)) Any\n  (select heap ref)\n)\n\n; ==========================================\n; === Class specific is/deref-functions: ===\n; ==========================================\n\n(define-fun deref-is-MathUtil ((this Ref)) Bool\n  (is-lift-MathUtil (deref this))\n)\n\n(define-fun deref-MathUtil ((this Ref)) MathUtil\n  (sel-MathUtil (deref this))\n)\n\n; ======================\n; === Isa-functions: ===\n; ======================\n\n(define-fun deref-isa-MathUtil ((this Ref)) Bool\n  (deref-is-MathUtil this)\n)\n\n; ================\n; === Getters: ===\n; ================\n\n; ================\n; === Methods: ===\n; ================\n\n; -------------------------------\n;   Methods for class MathUtil:\n; -------------------------------\n\n(define-fun MathUtil.min ((this Ref)(x Int)(y Int)) Int\n  (ite (<= x y) x y)\n)\n\n(define-fun MathUtil!min ((this Ref)(x Int)(y Int)) Int\n  (ite (<= x y) x y)\n)\n\n(assert (!(forall ((this Ref)(x Int)(y Int))\n  (=>\n    (and\n      (deref-is-MathUtil this)\n    )\n    (let (($result (MathUtil!min this x y)))\n      (and\n        (and (or (= $result x) (= $result y)) (and (<= $result x) (<= $result y)))\n      )\n    )\n  )\n) :named _xkassert0))\n\n(declare-fun MathUtil.max (Ref Int Int) Int)\n\n(define-fun MathUtil!max ((this Ref)(x Int)(y Int)) Int\n  (MathUtil.max this x y)\n)\n\n(define-fun MathUtil.abs ((this Ref)(x Int)) Int\n  (ite (< x 0) (- x) x)\n)\n\n(define-fun MathUtil!abs ((this Ref)(x Int)) Int\n  (ite (< x 0) (- x) x)\n)\n\n(assert (!(forall ((this Ref)(x Int))\n  (=>\n    (and\n      (deref-is-MathUtil this)\n    )\n    (let (($result (MathUtil!abs this x)))\n      (and\n        (and (>= $result 0) (or (= $result x) (= $result (- x))))\n      )\n    )\n  )\n) :named _xkassert1))\n\n; ===================\n; === Invariants: ===\n; ===================\n\n; ---------------------------------\n;   Invariant for class MathUtil:\n; ---------------------------------\n\n; --- Constants: ---\n\n(declare-const const-1-MathUtil MathUtil)\n\n\n\n\n; ======================\n; === Generate heap: ===\n; ======================\n\n(assert\n  (=\n    heap\n    (store\n      ((as const (Array Ref Any)) null)\n        1 (lift-MathUtil const-1-MathUtil))\n  )\n)\n\n",
  "smtModel": "(define-fun _xkassert1 () Bool\n  (forall ((this Int) (x Int))\n  (let ((a!1 (or (= (ite (< x 0) (- x) x) x) (= (ite (< x 0) (- x) x) (- x)))))\n  (let ((a!2 (and (>= (ite (< x 0) (- x) x) 0) a!1)))\n    (=> (and (is-lift-MathUtil (select heap this))) a!2)))))\n(define-fun _xkassert0 () Bool\n  (forall ((this Int) (x Int) (y Int))\n  (let ((a!1 (or (= (ite (<= x y) x y) x) (= (ite (<= x y) x y) y))))\n  (let ((a!2 (and a!1 (<= (ite (<= x y) x y) x) (<= (ite (<= x y) x y) y))))\n    (=> (and (is-lift-MathUtil (select heap this))) a!2)))))\n(define-fun NULL$Ref () Int\n  (- 1))\n(define-fun const-1-MathUtil () MathUtil\n  MathUtil!val!0)\n(define-fun heap () (Array Int Any)\n  (store ((as const (Array Int Any)) null) 1 (lift-MathUtil MathUtil!val!0)))",
